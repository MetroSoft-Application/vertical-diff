{
  "name": "vertical-diff",
  "displayName": "Vertical Diff",
  "description": "A VS Code extension that mirrors the active text diff editor into a stacked panel view for review.",
  "version": "1.0.2",
  "publisher": "MetroSoft-Application",
  "icon": "resources/vertical-diff.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetroSoft-Application/vertical-diff.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "diff",
    "vertical diff",
    "panel",
    "compare",
    "review"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "verticalDiff.show",
        "title": "Show Vertical Diff",
        "category": "Vertical Diff",
        "icon": "$(layout-panel)"
      },
      {
        "command": "verticalDiff.previousHunk",
        "title": "Previous Change",
        "category": "Vertical Diff",
        "icon": "$(chevron-up)"
      },
      {
        "command": "verticalDiff.nextHunk",
        "title": "Next Change",
        "category": "Vertical Diff",
        "icon": "$(chevron-down)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "verticalDiffPanel",
          "title": "Vertical Diff",
          "icon": "resources/vertical-diff.svg"
        }
      ]
    },
    "views": {
      "verticalDiffPanel": [
        {
          "id": "verticalDiff.view",
          "type": "webview",
          "name": "Active Diff",
          "icon": "resources/vertical-diff.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "verticalDiff.show",
          "when": "view == verticalDiff.view",
          "group": "navigation@1"
        },
        {
          "command": "verticalDiff.previousHunk",
          "when": "view == verticalDiff.view",
          "group": "navigation@2"
        },
        {
          "command": "verticalDiff.nextHunk",
          "when": "view == verticalDiff.view",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Vertical Diff",
      "properties": {
        "verticalDiff.fontSize": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "scope": "window",
          "markdownDescription": "Font size used by Vertical Diff. Set to `0` to follow `editor.fontSize`."
        },
        "verticalDiff.renderWhitespace": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Render half-width spaces as `·` and tabs as `→` in the Vertical Diff panel."
        }
      }
    }
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "compile": "tsc --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}